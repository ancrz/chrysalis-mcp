# chrysalis-bridge configuration reference.
#
# The code reads these ONLY from the process environment; nothing loads this file automatically.
# Either:
#   cp .env.example .env   # uncomment and edit what you need, then
#   set -a; . ./.env; set +a
# or put the variables in the MCP client's "env" block (see README, "Quickstart").
# Every line is commented out and shows the real default; uncommenting a line overrides it.
# Values in JSON "env" blocks and in `. ./.env` are NOT tilde-expanded in every client: prefer
# absolute paths when setting any path below.

# --- 1. MCP server runtime (chrysalis-mcp) ------------------------------------------------------

# SQLite memory substrate. Default: $XDG_DATA_HOME/chrysalis/substrate.db.
# CHRYSALIS_DB=~/.local/share/chrysalis/substrate.db
# SQLite file for learned advisory evidence. Default: advice.db next to the memory db.
# CHRYSALIS_ADVICE_DB=~/.local/share/chrysalis/advice.db
# Force the model profile for every session (overrides any handshake). Default: unset (unknown).
# CHRYSALIS_MODEL_PROFILE=
# 1 makes a "discouraged" advisory block the call unless params.override is true. Default: off.
# CHRYSALIS_ENFORCE_ADVISORY=0
# Advice exploration (Thompson-style); 0/false/off/no picks the higher posterior mean.
# CHRYSALIS_ADVICE_EXPLORE=1
# Minimum observations before learned advice is trusted (integer >= 1).
# CHRYSALIS_ADVICE_MIN_N=8
# Server-wide default for the opt-in bio features: off | all. "off" keeps every param off unless
# the caller passes it. "all" applies, when the caller OMITS the param: recall track_usage=true,
# inhibition=adaptive, encoder=flyvec (only if a FlyVec model exists, else n-grams); consolidate
# replay/usage_weighting/capture=true; and ingest retrains FlyVec (skipped above 5000 nodes).
# Explicit params always win. Shown as bio_defaults in meta.schema/handshake/discover.
# CHRYSALIS_BIO_DEFAULTS=off

# --- 2. Validation harness: LLM client and eval (python -m validation...) -----------------------

# OpenAI-compatible endpoint of the model under test.
# CHRYSALIS_LLM_URL=http://127.0.0.1:8080/v1
# Served model id for the client (default: auto-detected from GET /models, else the built-in id).
# The guarded launcher (section 3) reads the same name as the path of the GGUF file to serve.
# CHRYSALIS_LLM_MODEL=gemma-4-26B-A4B-it-Q4_0
# Thinking mode of the model under test: off | on.
# CHRYSALIS_LLM_THINKING=off
# Items of one eval arm in flight at once (match the server's CHRYSALIS_LLM_PARALLEL slots).
# CHRYSALIS_EVAL_CONCURRENCY=1
# Completion-token budget per request, thinking on / off.
# CHRYSALIS_EVAL_MAX_TOKENS_ON=2048
# CHRYSALIS_EVAL_MAX_TOKENS_OFF=512
# Request timeout in seconds, thinking on / off.
# CHRYSALIS_EVAL_TIMEOUT_ON=300
# CHRYSALIS_EVAL_TIMEOUT_OFF=120
# 1 = the advised arm reports each item's outcome via meta.feedback so meta.advise learns during
# the run (nondeterministic order when concurrency > 1). 0 = off. The learned advice db goes under
# CHRYSALIS_RESULTS_DIR (fresh per run) unless CHRYSALIS_ADVICE_DB is set.
# Learned evidence applies from the NEXT arm of the run (hint read at each arm's handshake).
# CHRYSALIS_EVAL_FEEDBACK=0
# Repetitions of each of the 15 independent H-bio steps (positive integer).
# CHRYSALIS_EVAL_BIO_REPS=3
# Output directory for result files (absolute, or relative to the repo root).
# CHRYSALIS_RESULTS_DIR=validation/results

# --- 3. Optional local llama.cpp guarded launcher (validation/llm_server.py) -------------------
# Defaults below are those of the default "e4b-km" profile; other profiles change model, alias, ctx, margins.

# Model preset (Gemma 4): e4b-km | e4b | 26b.
# CHRYSALIS_LLM_PROFILE=e4b-km
# Path to the llama-server binary.
# CHRYSALIS_LLM_BIN=~/.local/opt/llama.cpp/b12110/extract/llama-b12110/llama-server
# Jinja chat template overriding the GGUF's embedded one. Default: embedded (profile-dependent).
# CHRYSALIS_LLM_CHAT_TEMPLATE=~/.local/share/chrysalis/templates/<template>.jinja
# Server listen port.
# CHRYSALIS_LLM_PORT=8080
# Per-slot context window in tokens (the server allocates ctx * parallel).
# CHRYSALIS_LLM_CTX=8192
# Concurrent server slots (>= 1).
# CHRYSALIS_LLM_PARALLEL=1
# CPU threads.
# CHRYSALIS_LLM_THREADS=6
# Model name the server advertises.
# CHRYSALIS_LLM_ALIAS=gemma-4-e4b-q4km
# "minimal" (--no-host --no-repack) or "fast" (neither).
# CHRYSALIS_LLM_MEMORY_PROFILE=minimal
# Admission estimates, MiB: GPU footprint, extra KV cache per additional slot, RAM footprint.
# CHRYSALIS_LLM_EST_GPU_MIB=6656
# CHRYSALIS_LLM_EST_KV_MIB_PER_SLOT=512
# CHRYSALIS_LLM_EST_RAM_MIB=2048
# Free memory (MiB) that must remain after the server's footprint (preflight).
# CHRYSALIS_LLM_GTT_MARGIN_MIB=4096
# CHRYSALIS_LLM_RAM_MARGIN_MIB=4096
# Watchdog stops the server when free memory (MiB) drops below these floors.
# CHRYSALIS_LLM_GTT_FLOOR_MIB=2048
# CHRYSALIS_LLM_RAM_FLOOR_MIB=3072
# AMD DRM sysfs device dir with GTT counters. Default: auto-detect under /sys/class/drm.
# CHRYSALIS_SYSFS_DRM=/sys/class/drm/card0/device
