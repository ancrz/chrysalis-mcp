* text=auto eol=lf

# Line endings that must stay LF (sourced by shells / parsed by tools)
.env.example text eol=lf
*.sh    text eol=lf
*.jinja text eol=lf

# Diff drivers
*.py   diff=python
*.md   diff=markdown
*.toml diff=toml
*.json diff=json
*.yml  diff=yaml
*.yaml diff=yaml

# Generated files
*.lock                      -diff linguist-generated
uv.lock                     -diff linguist-generated
validation/results/*.json   linguist-generated

# Documentation
NOTICE                      linguist-documentation
LICENSE                     linguist-documentation

# Binary
*.gguf   binary
*.png    binary
*.db     binary
*.sqlite binary
*.db-wal binary
*.db-shm binary
*.safetensors binary
